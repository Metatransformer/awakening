class_name UiKit
extends RefCounted
## THE composition seam for every panel.
##
## The token layer below (`UITheme`) specifies PAINT — colours, styleboxes,
## fonts — and says nothing about COMPOSITION. That is why panels converge on the
## same shape without anyone choosing it: a title, a prose blob, and a stack of
## ten identical full-width buttons. Ten identical rows carry no hierarchy, so
## the eye has nothing to land on, and a screen with a story is indistinguishable
## from a screen with a list.
##
## This module is the layer above the styleboxes. Four verbs, in the order a
## panel uses them:
##
##     ┌──────────────────────────────────────────┐
##     │  plate_header()   what IS this thing     │  art + emblem + kicker + title
##     ├──────────────────────────────────────────┤
##     │  stat_band()      what STATE is it in    │  4-6 icon/value cells
##     ├──────────────────────────────────────────┤
##     │  (your prose)     what is GOING ON       │  the caller's own Label
##     ├──────────────────────────────────────────┤
##     │  verb_row() × n   what can I DO          │  icon + label + META column
##     ├──────────────────────────────────────────┤
##     │  footer_toast()   what just HAPPENED     │  never above what it reports on
##     └──────────────────────────────────────────┘
##
## Every verb is a pure factory: it builds nodes, parents them, and returns the
## root. No state lives here, so a panel can rebuild a band or a row list without
## tearing the module down.
##
## A composite column has NO outer content padding. Host it in
## `UITheme.style_panel(panel, fill, true)` so the header, band, rows and footer
## reach the frame edge. Each composite owns its own intentional inset.

const UITheme := preload("res://scripts/ui/ui_theme.gd")
const PlateHeaderScript := preload("res://scripts/ui/kit/plate_header.gd")
const StatBandScript := preload("res://scripts/ui/kit/stat_band.gd")
const VerbRowScript := preload("res://scripts/ui/kit/verb_row.gd")
const FooterToastScript := preload("res://scripts/ui/kit/footer_toast.gd")
const KitIconScript := preload("res://scripts/ui/kit/kit_icon.gd")

# ---- the icon families -------------------------------------------------------
## THE row glyphs: 24px vellum line SVGs, one stroke weight for the whole family,
## generated by `tools/gen_icons/build_ui_icons.py`.
##
## These and only these belong in a `verb_row` or a `stat_band`. The painted
## 256px slot art below is NOT interchangeable with them — at 19px it renders as
## a dark smudge that reads as a rendering fault. Line art is authored at the
## size it is drawn.
const ACTION := "res://assets/icons/actions/"
## The eight worn slots, from the same generator and at the same weight, for the
## `SlotTile`s flanking the doll. Separate from ACTION because they are nouns:
## a `chest` here is a cuirass, and a `chest` in ACTION is the thing you open.
const WORN := "res://assets/icons/worn/"
## Equipment-slot art, keyed by the body slot it marks. Painted, 256px, and sized
## for a paper-doll socket — an empty socket wears its own art, so the doll reads
## as a body with places on it rather than a row of empty boxes.
const SLOT := "res://assets/icons/slots/"
## Gamepad face/d-pad/trigger glyphs, for a control hint that shows the button
## instead of naming it.
const BUTTON := "res://assets/icons/buttons/"


## A panel that is ABOUT a thing opens with that thing's face.
##
## `config` keys — all optional except `title`:
##   title   : String            the name, in the display face
##   kicker  : String            "RARE · INGREDIENT" — uppercased, gold
##   art     : Texture2D|String  the ARCHETYPE plate, never per-instance art
##   emblem  : Texture2D|String  glyph drawn beside the title
##   edge    : Color             a semantic edge down the left of the band
##   height  : int               band height; defaults to the letterbox when
##                               there IS art, and to measured text when not
static func plate_header(parent: Node, config: Dictionary) -> Control:
	var resolved := resolve_icon(config.get("art"))
	var model := config.duplicate(true)
	model["art"] = resolved
	var header: Control = PlateHeaderScript.build(parent, model)
	if header != null:
		header.set_meta("plate_art_texture", resolved)
		header.set_meta("plate_art_path", String(config.get("art", "")))
	return header


## The numbers that let a player choose BEFORE committing to the primary verb.
##
## `cells` is an Array of Dictionaries:
##   value : String              the number itself — "308", "4 / 12"
##   label : String              a short uppercase caption — "Bag"
##   icon  : Texture2D|String    optional 13px glyph beside the value
##   tone  : Color               ONLY UITheme.SUCCESS / DANGER / WARNING
##
## 4-6 cells is the rule, not a suggestion.
static func stat_band(parent: Node, cells: Array) -> Control:
	return StatBandScript.build(parent, cells)


## One row of the verb list. Replaces the stack of identical full-width buttons.
##
##     [icon 19px]  Label ....................... meta  ›
##
## `config` keys:
##   label    : String    required
##   icon     : Texture2D|String
##   meta     : String    THE RIGHT-HAND COLUMN — cost, count, duration,
##                        consequence. This is the point of the component.
##   primary  : bool      promotes to the display face. EXACTLY ONE per panel.
##   submenu  : bool      appends "›" — means "this opens a page", never
##                        "this does a thing"
##   refused  : String    non-empty renders the REFUSAL state and makes the row
##                        non-focusable
##   on_press : Callable  connected to `pressed` unless refused
##
## THE REFUSAL LAW: a refused row stays VISIBLE at 38% with its reason in the
## meta column, never removed. A menu that silently changes shape between visits
## cannot be learned, and the player is left guessing whether the feature exists.
static func verb_row(parent: Node, config: Dictionary) -> Button:
	return VerbRowScript.build(parent, config)


## An outcome message, pinned to the panel FOOTER. The panel is responsible for
## parenting it into the footer — the kit builds the toast, it cannot enforce
## where you put it, and putting it above the content is the bug this component
## exists to prevent.
static func footer_toast(parent: Node, text: String, tone: Color = UITheme.SUCCESS) -> Control:
	return FooterToastScript.build(parent, text, tone)


## What a control SAYS, whether it is a plain Button or a composed `VerbRow`.
##
## A VerbRow's own `text` is empty by construction, so `button.text == "Options"`
## — which is how every keyboard-navigation director in this repo finds a control
## — silently stops matching the moment a screen adopts the kit. One reader, here,
## rather than each director growing its own special case.
static func label_of(control: Control) -> String:
	if control == null:
		return ""
	if control.has_meta(&"verb_label"):
		return String(control.get_meta(&"verb_label"))
	var button := control as Button
	return button.text if button != null else ""


## Resolve an icon argument that may be a live Texture2D, a `res://` path, or
## absent. The rule lives in KitIcon because the composites need it too, and
## UiKit preloads them all — putting it here and having them call back would make
## the preload graph cyclic.
static func resolve_icon(value: Variant) -> Texture2D:
	return KitIconScript.resolve(value)


## The path to a row glyph, or "" when the family has none by that name.
##
## Returning "" rather than a placeholder is deliberate: `KitIcon` degrades a
## missing icon to a row without one, and a wrong glyph is worse than no glyph.
## Add a name to the generator, not a one-off file next to it.
static func action_icon(name: String) -> String:
	return _line_icon(ACTION, name)


## The path to a worn-slot glyph. `ring1`/`ring2` both draw the ring: the tile's
## caption is what tells them apart, and two rings that looked different would
## imply a difference the game does not have.
static func worn_icon(slot: StringName) -> String:
	var name := String(slot)
	if name.begins_with("ring"):
		name = "ring"
	return _line_icon(WORN, name)


static func _line_icon(family: String, name: String) -> String:
	var path := family + name + ".svg"
	if ResourceLoader.exists(path) or FileAccess.file_exists(path):
		return path
	push_warning("[UiKit] glyph='%s%s' reason=not in the family; add it to tools/gen_icons/build_ui_icons.py"
		% [family, name])
	return ""


## The path to an equipment-slot's painted art, or "" when we have none.
static func slot_icon(slot: String) -> String:
	var path := SLOT + slot + ".png"
	return path if ResourceLoader.exists(path) else ""


## The rarity edge for a PlateHeader on an ITEM.
##
## Rarity colour is `Pal`'s, not the theme's: it is game-semantic (it changes
## when the loot tables change) and it is authored on the PSX RGB555 grid. The
## kit borrows it here rather than mirroring it, so there is one rarity ramp.
static func rarity_edge(rarity: int) -> Color:
	return Pal.rarity_color(rarity)
