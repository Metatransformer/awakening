class_name PixelFont
extends RefCounted
## A 5x7 bitmap font drawn as rectangles, with no font file behind it.
##
## Two reasons this exists rather than a .ttf:
##
##  1. docs/STYLEGUIDE.md bans the engine's fallback font -- Open Sans in a PSX
##     dungeon is the loudest "unfinished" signal available -- and bans vector
##     icon sets. A glyph made of whole pixels at an integer scale is exactly
##     what the treatment asks for, and it cannot be antialiased by accident.
##  2. It is monospaced with tabular figures for free, so a gold counter rolling
##     up from 90 to 100 does not reflow while it counts.
##
## Rows are read most-significant-bit first across 5 columns, top row first.
## Anything not in the table draws as a filled block, which is honest about a
## missing glyph rather than silently dropping it.

const W := 5
const H := 7
## Blank columns between glyphs, in font pixels.
const TRACKING := 1

const GLYPHS := {
	" ": [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],
	"0": [0x0E, 0x11, 0x13, 0x15, 0x19, 0x11, 0x0E],
	"1": [0x04, 0x0C, 0x04, 0x04, 0x04, 0x04, 0x0E],
	"2": [0x0E, 0x11, 0x01, 0x02, 0x04, 0x08, 0x1F],
	"3": [0x1F, 0x02, 0x04, 0x02, 0x01, 0x11, 0x0E],
	"4": [0x02, 0x06, 0x0A, 0x12, 0x1F, 0x02, 0x02],
	"5": [0x1F, 0x10, 0x1E, 0x01, 0x01, 0x11, 0x0E],
	"6": [0x06, 0x08, 0x10, 0x1E, 0x11, 0x11, 0x0E],
	"7": [0x1F, 0x01, 0x02, 0x04, 0x08, 0x08, 0x08],
	"8": [0x0E, 0x11, 0x11, 0x0E, 0x11, 0x11, 0x0E],
	"9": [0x0E, 0x11, 0x11, 0x0F, 0x01, 0x02, 0x0C],
	"A": [0x0E, 0x11, 0x11, 0x1F, 0x11, 0x11, 0x11],
	"B": [0x1E, 0x11, 0x11, 0x1E, 0x11, 0x11, 0x1E],
	"C": [0x0E, 0x11, 0x10, 0x10, 0x10, 0x11, 0x0E],
	"D": [0x1C, 0x12, 0x11, 0x11, 0x11, 0x12, 0x1C],
	"E": [0x1F, 0x10, 0x10, 0x1E, 0x10, 0x10, 0x1F],
	"F": [0x1F, 0x10, 0x10, 0x1E, 0x10, 0x10, 0x10],
	"G": [0x0E, 0x11, 0x10, 0x17, 0x11, 0x11, 0x0F],
	"H": [0x11, 0x11, 0x11, 0x1F, 0x11, 0x11, 0x11],
	"I": [0x0E, 0x04, 0x04, 0x04, 0x04, 0x04, 0x0E],
	"J": [0x07, 0x02, 0x02, 0x02, 0x02, 0x12, 0x0C],
	"K": [0x11, 0x12, 0x14, 0x18, 0x14, 0x12, 0x11],
	"L": [0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x1F],
	"M": [0x11, 0x1B, 0x15, 0x15, 0x11, 0x11, 0x11],
	"N": [0x11, 0x11, 0x19, 0x15, 0x13, 0x11, 0x11],
	"O": [0x0E, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0E],
	"P": [0x1E, 0x11, 0x11, 0x1E, 0x10, 0x10, 0x10],
	"Q": [0x0E, 0x11, 0x11, 0x11, 0x15, 0x12, 0x0D],
	"R": [0x1E, 0x11, 0x11, 0x1E, 0x14, 0x12, 0x11],
	"S": [0x0F, 0x10, 0x10, 0x0E, 0x01, 0x01, 0x1E],
	"T": [0x1F, 0x04, 0x04, 0x04, 0x04, 0x04, 0x04],
	"U": [0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0E],
	"V": [0x11, 0x11, 0x11, 0x11, 0x11, 0x0A, 0x04],
	"W": [0x11, 0x11, 0x11, 0x15, 0x15, 0x1B, 0x11],
	"X": [0x11, 0x11, 0x0A, 0x04, 0x0A, 0x11, 0x11],
	"Y": [0x11, 0x11, 0x0A, 0x04, 0x04, 0x04, 0x04],
	"Z": [0x1F, 0x01, 0x02, 0x04, 0x08, 0x10, 0x1F],
	"-": [0x00, 0x00, 0x00, 0x1F, 0x00, 0x00, 0x00],
	".": [0x00, 0x00, 0x00, 0x00, 0x00, 0x0C, 0x0C],
	",": [0x00, 0x00, 0x00, 0x00, 0x0C, 0x0C, 0x08],
	":": [0x00, 0x0C, 0x0C, 0x00, 0x0C, 0x0C, 0x00],
	"/": [0x01, 0x02, 0x02, 0x04, 0x08, 0x08, 0x10],
	"+": [0x00, 0x04, 0x04, 0x1F, 0x04, 0x04, 0x00],
	"!": [0x04, 0x04, 0x04, 0x04, 0x04, 0x00, 0x04],
	"?": [0x0E, 0x11, 0x01, 0x02, 0x04, 0x00, 0x04],
	"'": [0x04, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00],
	"(": [0x02, 0x04, 0x08, 0x08, 0x08, 0x04, 0x02],
	")": [0x08, 0x04, 0x02, 0x02, 0x02, 0x04, 0x08],
	"%": [0x11, 0x12, 0x02, 0x04, 0x08, 0x09, 0x11],
	"*": [0x00, 0x0A, 0x04, 0x1F, 0x04, 0x0A, 0x00],
	# The chevrons exist so an upgrade can say "this becomes that" -- the forge
	# prints "8.7 M REACH -> 11.9 M REACH". Without them `>` fell through to
	# MISSING and the shop drew a solid block mid-sentence.
	">": [0x00, 0x10, 0x08, 0x04, 0x08, 0x10, 0x00],
	"<": [0x00, 0x01, 0x02, 0x04, 0x02, 0x01, 0x00],
}
const MISSING := [0x1F, 0x1F, 0x1F, 0x1F, 0x1F, 0x1F, 0x1F]


## Width of `text` in screen pixels at `scale` (screen px per font px).
static func width(text: String, scale: float) -> float:
	if text.is_empty():
		return 0.0
	return (text.length() * (W + TRACKING) - TRACKING) * scale


static func height(scale: float) -> float:
	return H * scale


## Break `text` on spaces so no line exceeds `max_width` screen pixels, capped
## at `max_lines` (the overflow is dropped, not squeezed).
##
## Every glyph here is the same width, so this is character counting rather than
## real typesetting -- which is the whole reason it can live in eight lines. It
## exists because the shop drew its blurb as one unwrapped line and the longer
## forge blurbs ran out through the right edge of the panel and kept going.
static func wrap(text: String, scale: float, max_width: float,
		max_lines: int = 2) -> PackedStringArray:
	var per_char := (W + TRACKING) * scale
	var cols: int = maxi(1, int((max_width + TRACKING * scale) / per_char))
	var lines := PackedStringArray()
	var line := ""
	for word in text.split(" ", false):
		var candidate: String = word if line.is_empty() else line + " " + word
		if candidate.length() <= cols:
			line = candidate
			continue
		if not line.is_empty():
			lines.append(line)
			if lines.size() >= max_lines:
				return lines
		# A single word longer than the line gets cut rather than overhanging.
		line = word.substr(0, cols)
	if not line.is_empty() and lines.size() < max_lines:
		lines.append(line)
	return lines


## Draw `text` with its TOP-LEFT at `at`. Uppercased, because the table has no
## lowercase and a silently-missing 'e' is worse than a shouted one.
##
## One `draw_rect` per lit pixel is fine here: the HUD repaints on signal, not
## per frame, and the whole overlay is a few hundred rects.
static func draw_text(ci: CanvasItem, text: String, at: Vector2,
		scale: float, color: Color) -> float:
	var up := text.to_upper()
	var x := at.x
	for i in up.length():
		var rows: Array = GLYPHS.get(up[i], MISSING)
		for row in H:
			var bits: int = rows[row]
			for col in W:
				if bits & (1 << (W - 1 - col)):
					ci.draw_rect(Rect2(
						x + col * scale, at.y + row * scale, scale, scale), color)
		x += (W + TRACKING) * scale
	return x - at.x


## Same, but the text ENDS at `right`. Every number in this HUD is right-aligned
## so the digits stay in place as the value grows.
static func draw_right(ci: CanvasItem, text: String, right: Vector2,
		scale: float, color: Color) -> void:
	draw_text(ci, text, Vector2(right.x - width(text, scale), right.y), scale, color)


static func draw_centred(ci: CanvasItem, text: String, centre: Vector2,
		scale: float, color: Color) -> void:
	draw_text(ci, text, Vector2(
		centre.x - width(text, scale) * 0.5, centre.y), scale, color)
