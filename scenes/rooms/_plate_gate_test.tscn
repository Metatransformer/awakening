[gd_scene load_steps=5 format=3]

; The plate fixture: the proving ground with a PuzzleGate in its north doorway
; whose one atom is a PRESSURE PLATE. Owned by tools/directors/plate_gate.gd.
;
; Underscore-prefixed like _atom_test.tscn and _gate_test.tscn -- it is a
; harness, not a room the game ships.
;
; **Why this is a second fixture and not a beat in _atom_test.tscn.** That one's
; Gate watches three EYE SWITCHES, and every eye latches: it is the fixture for
; a door that opens once and stays open, which is what a gate on latching atoms
; is supposed to do. The claim here is the opposite one -- a door that comes back
; SHUT -- and it needs a gate whose set can go backwards. Sharing one gate
; between the two would mean a director mutating another director's set, and the
; eye row's "the last atom opens the gate by itself" check would start depending
; on which file ran first.
;
; The plate and the block are NOT in this file. The director builds them through
; `PuzzleAtoms.make()`, which is the call a generator makes, for the same reason
; `_atom_test.tscn` leaves its nine out: a fixture that instanced the scripts
; directly would prove the props and nothing about the kit.
;
; The gate IS authored here, because its exports are the interesting half of it
; and `mark_tier = 0` on a T0 atom is exactly the row a placer has to get right.

[ext_resource type="PackedScene" path="res://scenes/rooms/proving_ground.tscn" id="ground"]
[ext_resource type="PackedScene" path="res://scenes/actors/hero/hero.tscn" id="hero"]
[ext_resource type="PackedScene" path="res://scenes/camera/game_camera.tscn" id="camera"]
[ext_resource type="Script" path="res://scripts/props/puzzle_gate.gd" id="gate"]

[node name="PlateGateTest" type="Node3D"]

[node name="Ground" parent="." instance=ExtResource("ground")]

; Set 50 mm back into the reveal, exactly as _gate_test.tscn and _atom_test.tscn
; seat their doors, so the doorway's surround frames the leaves instead of the
; leaves standing proud of it.
[node name="Gate" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -10.05)
script = ExtResource("gate")
puzzle_id = &"plate_demo"
mark_tier = 0
label = "The Sluice Gate"
destination = &"plate_demo"

[node name="Hero" parent="." instance=ExtResource("hero")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.05, 4)

[node name="GameCamera" parent="." instance=ExtResource("camera")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.7, 7)
