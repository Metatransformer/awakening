; The arena is the CHAMBER's middle, not the boss's. `BossDb` authors a radius
; and the seal, the trigger and the scatter for zone discs are all measured from
; here, so an arena whose origin sat on the boss would drift with it.
[node name="Arena" type="Area3D" parent="."]
script = ExtResource("arena")
boss_id = &"cistern_warden"
door_path = NodePath("../BossDoor")
boss_offset = Vector3(0, 0, -5)

; Set 50 mm back into the reveal, the same as _gate_test's doors, so the
; doorway's surround frames the leaves instead of the leaves standing proud of
; it. The opening matches the hole the wall segments leave.
[node name="BossDoor" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -13.05)
script = ExtResource("bossdoor")
boss_id = &"cistern_warden"
label = "The Long Descent"
opening_w = 5.0
opening_h = 5.0

[node name="Hero" parent="." instance=ExtResource("hero")]
