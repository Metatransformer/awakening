[rendering]

rendering_device/driver.windows="d3d12"
; The macOS export REFUSES to build universal or arm64 without this — it is a
; hard configuration error, not a warning, and it is why `pnpm deploy` would
; otherwise die on the first preset. Apple GPUs want ASTC, and Godot will not
; ship a bundle that has no ASTC variant to hand them.
; Turning it on re-imports every texture with an extra variant: .godot/imported/
; grows and so does the export. That is the price of an Apple Silicon build that
; is not Rosetta-only, and on this project's texture count it is worth it.
textures/vram_compression/import_etc2_astc=true
; STYLEGUIDE 8's deltas, applied 2026-08-10 after card #20 measured a baseline
; rather than guessing at one. These four were never chosen -- they are what the
; project happened to have -- and they are the four most expensive settings in
; the file. They are ALSO what the PSX treatment wants: MSAA and FXAA both fight
; the hard pixel edge STYLEGUIDE 2 is built on, so turning them off is the art
; direction and the frame budget agreeing for once.
;
; The shadow map was 8192x8192 -- 64 megatexels, re-rendered every frame from a
; scene with 713 draw calls in it -- behind soft_shadow_filter_quality=4, the
; most expensive filter Godot has. 1024 is STYLEGUIDE 8's number and it is four
; texels per centimetre at this game's metric.
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
