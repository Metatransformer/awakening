; Look around out of his own eyes. R3 -- button 8, JOY_BUTTON_RIGHT_STICK --
; because BOTW clicks the right stick for exactly this and the thumb is already
; on that stick doing exactly this with the camera.
;
; This action was bound to R and read by NOTHING for a long time, which is the
; thing §4 of the contract says not to do. It shipped with the mode:
; GameCamera.set_first_person collapses the boom to zero, Hero roots himself and
; hides his model on Bus.first_person_changed, and both landed in this commit.
;
; R3 was free because it had to be taken from `z_target`, which no longer needs
; a pad button of its own -- the left trigger is the pad's Z now and does the
; whole job. See the note there.
first_person={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":82,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":8,"pressure":0.0,"pressed":false,"script":null)
]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":6,"pressure":0.0,"pressed":false,"script":null)
]
}
; The pouch, straight open -- I on the keyboard, SELECT (button 4, "Back") on
; the pad. It is the same menu `pause` opens, entered one screen deeper, because
; "what am I carrying and can I afford to leave" is the question players ask
; between every room and it should not cost two presses and a focus move.
;
; Select is the right pad button for it: it is the only face-adjacent button
; nothing else wanted, and every game that has an inventory puts it there.
