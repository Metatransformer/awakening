; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Lower Worlds: Awakening"
; The loop starts in town. Booting into the dungeon dropped the player into the
; middle of a run they never chose to take, with nowhere to spend what they
; carried out of it.
run/main_scene="res://scenes/rooms/town.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Bus="*res://scripts/autoload/event_bus.gd"
Game="*res://scripts/autoload/game_state.gd"
; Run must load after Game: it spends and grants gold on the way in and out.
Run="*res://scripts/autoload/run_state.gd"
; Heat is the momentum meter: kills chain, the chain decays, and what it is
; worth gets stamped onto loot. After Game (it refunds stamina on a kill) and
; after Run (it refuses to build a chain outside the dungeon). Before Hud, which
; reads Heat.window01() every frame it draws.
Heat="*res://scripts/autoload/heat.gd"
Settings="*res://scripts/autoload/settings.gd"
Saves="*res://scripts/autoload/save_game.gd"
; Music picks the track and crossfades it. It must load after Bus (it listens
; for boss_engaged) and after Settings, which owns the Music bus volume the
; pause-menu slider drives. The 15 tracks in res://audio/music/ were imported
; and then never played by anything; this is what plays them.
Music="*res://scripts/autoload/music.gd"
; Sfx implements Bus.request_sfx -- which was declared in event_bus.gd with no
; emitter and no listener -- and owns the signal->sound table. After Bus, which
; it connects to on _ready.
Sfx="*res://scripts/autoload/sfx.gd"
; Feel implements Bus.request_hitstop and Bus.request_shake -- both declared in
; event_bus.gd, both emitted from four scripts, and neither with a listener
; anywhere in the project until now. After Settings (it reads camera_shake) and
; after Game (it seeds itself from Game.quarters so the first blow of a session
; is not read as a heal). Its vignette is a CanvasLayer at 60: above the HUD,
; below the pause menu.
Feel="*res://scripts/autoload/feel.gd"
; The HUD is an autoload so the overlay exists whatever scene the launcher
; picks. It hides itself unless a node in group `player` is in the tree, so
; lookdev and tool scenes stay clean.
Hud="*res://scripts/ui/hud/hud.gd"
; Prompt arbitrates which Interactable owns the interact button; it needs Bus.
Prompt="*res://scripts/autoload/prompt.gd"
; The pause menu is an autoload for the same reason the HUD is: Escape has to
; work in whatever scene the launcher picks, not just the two the metagame
; routes between. It shipped fully built but instanced in nothing except
; scenes/ui/menu/_menu_test.tscn, so the game itself had no escape menu.
; Layer 100 -- above the HUD (50), below Flow's fade (200). It boots hidden, so
; lookdev and tool scenes stay clean. This is the ONLY instance in the project.
Menu="*res://scenes/ui/menu/pause_menu.tscn"
; Flow owns the town<->dungeon scene change and the fade. It must load LAST: its
; fade veil has to sit above every other autoload's CanvasLayer.
Flow="*res://scripts/autoload/game_flow.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/size/mode=2
window/size/resizable=true

[input]

; The engine defaults for these two are KEYBOARD ONLY -- verified at runtime with
; tools/scenes/_uidump.tscn, not by reading this file, because an action absent
; here is silently supplied by the engine. ui_up/down/left/right DO ship with
; D-pad and stick bindings, so a pad player could move the pause menu focus and
; then had no button that confirmed or cancelled anything.
; Nintendo layout: A confirms, B backs out.
; NOTE: comments in this file must start with ";". A "#" comment is a PARSE
; ERROR that silently eats the assignment following it -- that is exactly how
; this block failed to apply the first time, while the next one down worked.
;
; NOTE 2, and it has cost this project a whole pad layout twice: `button_index`
; is Godot's JoyButton enum, NOT the SDL/Xbox raw numbering people quote from
; memory. The two disagree exactly where it hurts:
;
;     0 A/Cross   1 B/Circle   2 X/Square   3 Y/Triangle   4 Back   5 GUIDE
;     6 Start     7 L3         8 R3         9 LB/L1       10 RB/R1
;    11..14 D-pad U/D/L/R
;
; A previous pass wrote attack=5 and lock-on=9 believing 5 was RB and 9 was R3.
; That bound attack to the Xbox HOME button, so the pad had no attack at all.
; Do not derive these. Print them:
;   godot --path . --headless res://tools/scenes/_padnames.tscn
; which dumps the enum out of the engine AND the bindings live at runtime --
; the second half matters because user://settings.cfg is replayed over this
; file at boot (see Settings.BIND_SCHEMA).
ui_accept={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
]
}
ui_cancel={
