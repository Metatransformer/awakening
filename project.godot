; Lock-on. A TOGGLE, not a hold: press to lock, press again to let go, press
; with nothing lockable to put the camera back behind the hero.
; scripts/targeting/targeting.gd owns that.
;
; The pad's home for it is the LEFT TRIGGER -- JoyAxis 4 (TRIGGER_LEFT), bound
; as an InputEventJoypadMotion the same way the sticks are, so the deadzone is
; how far the trigger has to travel before it counts as pressed. That is Z on
; the N64 controller, and the whole camera lives under one finger there: the
; right stick swings the lens, the trigger snaps it back behind you. R3 stays
; bound too (Elden Ring's arrangement) because a thumb already resting on the
; right stick should not have to travel to recentre.
;
; The trigger used to be the shield. The shield is LB now -- see `shield`.
z_target={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":3,"canceled":false,"pressed":false,"double_click":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":81,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":4,"axis_value":1.0,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":8,"pressure":0.0,"pressed":false,"script":null)
]
}
; Attack is X/Square -- button 2, "Left Action". It moved off A because A had to
; become the USE button (see `use_item` below), and because the sword is the one
; thing in this game that is never put away: OOT keeps it on B forever and puts
; the items on the C-pad, and the whole reason an item can be drawn here without
; getting stuck is that a different button always swings.
;
; There is no `heavy_attack` any more. The heavy is the CHARGE: tap X for the
; light chain, hold X to wind up, release to swing it. One button, and the cost
; is time rather than a second thing to reach for -- which is the arrangement
; every Zelda spin attack has used. hero_combat.gd owns the hold clock.
attack={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":false,"double_click":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":2,"pressure":0.0,"pressed":false,"script":null)
]
}
; Use is A/Cross -- button 0, the thumb's rest position, which attack vacated.
; It is the "do the thing you are holding" button: it fires the bow or the
; hookshot when one is drawn, and with the sword out and something locked it is
; the lunge. With the sword out and nothing locked it does nothing, deliberately
; -- that is OOT's A exactly, where the jump attack only exists under Z.
;
; Keyboard is F, inherited from the heavy it replaced: left hand, without
; leaving WASD.
use_item={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":70,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
]
}
; Block is the other half of the mouse: LMB swings, RMB raises the shield. It
; used to be K and Shift only, with RMB on z_target, and nobody found it -- the
; lock-on moved to the middle button, which is the thing you can afford to hide.
;
; On the pad the shield WAS the left trigger, bound as an axis. It is LB now --
; button 9, JOY_BUTTON_LEFT_SHOULDER -- because the trigger had to become the
; camera button (see z_target above), and because a shoulder is where Elden Ring
; puts the guard anyway. The pair reads correctly under one finger: the trigger
; aims the camera, the bumper above it raises the shield.
;
; Still a HELD control and still polled with is_action_pressed -- a button just
; reports 0 or 1 through the same deadzone the axis was read through, so nothing
; downstream in hero_combat changed.
shield={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":2,"canceled":false,"pressed":false,"double_click":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":9,"pressure":0.0,"pressed":false,"script":null)
]
}
; Roll is B/Circle, Elden Ring's arrangement, and is unchanged.
;
; Interact USED to be A/Cross next to it, also ER's. A is `use_item` now, so
; interact stays up on Y/Triangle -- button 3, "Top Action", the only face
; button nothing else wanted. Sharing A between use and interact is not an
; option even though `interact` still shares it with ui_accept: ui_accept is
; safe because trade_screen's accept edge starts DISARMED, so the press that
; opens a screen cannot also confirm inside it. Nothing equivalent guards the
; world -- hero_combat polls its buttons every physics frame with no such edge,
; so one press at a chest would open it and loose an arrow through it.
