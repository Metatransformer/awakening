extends RefCounted
## Does a generated floor actually contain the arrows it promises?
##
## The chest and the bundle are proved as objects by `arrow_supply.gd`. This is
## the other half: that `Dungeon` puts them in ROOMS, at the rates the two
## `@export`s claim, and that they land somewhere a player walks rather than
## inside a wall or on top of the stairs.
##
## It walks several seeds rather than one, because a single floor tells you
## nothing about a 25% roll — one floor with no bundles is the expected outcome
## a fifth of the time, and "it worked when I ran it" is how a placement bug
## survives to the build.
##
##   godot --path . -s tools/shoot.gd -- \
##     --scene=res://scenes/rooms/dungeon.tscn \
##     --director=res://tools/directors/dungeon_supply.gd --out=/tmp/dun/d.png

## Floors to generate. Enough that both rolls have to show up at their stated
## rate rather than by luck.
const FLOORS := 8

var _fails: int = 0


func _fail(msg: String) -> void:
	_fails += 1
	push_error("DUNGEON FAIL %s" % msg)
	print("DUNGEON FAIL %s" % msg)


func run(rig) -> void:
	# THE BOOT KIT IS GONE (game_state.gd STARTER_KIT is empty now, docs/SCOPE.md
	# M1): the bow, the hookshot and the thirty arrows used to be handed over in
	# `Game._ready()`, and this director was written on top of that. It exercises
	# the gear rather than the earning of it, so it hands itself the same three
	# things the boot used to -- the alternative is a director that fails for a
	# reason that has nothing to do with what it claims.
	Game.grant(&"bow")
	Game.grant(&"hookshot")
	if Game.arrows < 30:
		Game.add_arrows(30 - Game.arrows)

	var out: String = rig.arg("out", "/tmp/dun/d.png").get_base_dir()
	await rig.wait_frames(30)

	var scene: Node = rig.scene()
	var dungeon := _find_dungeon(scene)
	if dungeon == null:
		_fail("no Dungeon in the scene")
		return

	var chests := 0
	var bundles := 0
	var rooms := 0
	var arrows_on_floor := 0

	# The floor already built during warmup is the first sample; the rest are
	# generated by re-entering with a fresh seed, which is exactly what taking a
	# stair does.
	for f in FLOORS:
		if f > 0:
			Run.enter(700000 + f * 4321)
			dungeon.call(&"_ready")
			await rig.wait_frames(6)
		var counts := _census(dungeon)
		rooms += int(counts["rooms"])
		chests += int(counts["chests"])
		bundles += int(counts["bundles"])
		arrows_on_floor += int(counts["arrows"])
		print("FLOOR %d rooms=%d chests=%d bundles=%d arrows=%d"
			% [f, counts["rooms"], counts["chests"], counts["bundles"],
			counts["arrows"]])

	print("TOTAL rooms=%d chests=%d bundles=%d loose_arrows=%d"
		% [rooms, chests, bundles, arrows_on_floor])

	if chests <= 0:
		_fail("%d floors and not one chest" % FLOORS)
	if bundles <= 0:
		_fail("%d floors, %d rooms, and not one loose bundle at arrow_chance=%.2f"
			% [FLOORS, rooms, dungeon.get(&"arrow_chance")])
	# A rate this far off its export is a placement bug, not variance: at 25%
	# over ~40 non-entrance rooms, landing outside 5%-60% is vanishingly unlikely.
	var rate := float(bundles) / float(maxi(rooms, 1))
	print("RATE bundles/room=%.2f (arrow_chance=%.2f)"
		% [rate, dungeon.get(&"arrow_chance")])
	if rate < 0.05 or rate > 0.60:
		_fail("bundles land in %.0f%% of rooms — the export says %.0f%%"
			% [rate * 100.0, float(dungeon.get(&"arrow_chance")) * 100.0])

	# And a picture: a chest in the dungeon's OWN light, which is the only light
	# it will ever be seen in. The lookdev shot is on a grey plane under a key
	# light and flatters it.
	var chest := _first_chest(dungeon)
	if chest == null:
		_fail("could not find a chest to photograph")
	else:
		var cam := Camera3D.new()
		cam.fov = 46.0
		scene.add_child(cam)
		cam.make_current()
		cam.global_position = chest.global_position + Vector3(2.0, 1.6, 2.4)
		cam.look_at(chest.global_position + Vector3.UP * 0.4, Vector3.UP)
		await rig.wait_frames(4)
		await rig.capture(out.path_join("dn_chest_insitu.png"))

		var bundle := _first_bundle(dungeon)
		if bundle != null:
			cam.global_position = bundle.global_position + Vector3(0.0, 1.5, 2.6)
			cam.look_at(bundle.global_position + Vector3.UP * 0.1, Vector3.UP)
			await rig.wait_frames(4)
			await rig.capture(out.path_join("dn_bundle_insitu.png"))
		cam.queue_free()

	print("DUNGEONCHECK fails=%d" % _fails)


func _census(dungeon) -> Dictionary:
	var out := {"rooms": 0, "chests": 0, "bundles": 0, "arrows": 0}
	for cell: Vector2i in dungeon.rooms:
		var room: Node3D = dungeon.rooms[cell]["node"]
		if room == null:
			continue
		out["rooms"] = int(out["rooms"]) + 1
		for c in room.get_children():
			if c is Chest:
				out["chests"] = int(out["chests"]) + 1
			elif c is ArrowBundle:
				out["bundles"] = int(out["bundles"]) + 1
				out["arrows"] = int(out["arrows"]) + (c as ArrowBundle).count
	return out


func _first_chest(dungeon) -> Chest:
	for cell: Vector2i in dungeon.rooms:
		var room: Node3D = dungeon.rooms[cell]["node"]
		if room == null:
			continue
		for c in room.get_children():
			if c is Chest:
				return c as Chest
	return null


func _first_bundle(dungeon) -> ArrowBundle:
	for cell: Vector2i in dungeon.rooms:
		var room: Node3D = dungeon.rooms[cell]["node"]
		if room == null:
			continue
		for c in room.get_children():
			if c is ArrowBundle:
				return c as ArrowBundle
	return null


func _find_dungeon(n: Node) -> Node:
	if n is Dungeon:
		return n
	for c in n.get_children():
		var found := _find_dungeon(c)
		if found != null:
			return found
	return null
